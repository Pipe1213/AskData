ASKDATA_ENV=development
ASKDATA_LOG_LEVEL=INFO
ASKDATA_APP_NAME=AskData Backend
ASKDATA_APP_VERSION=0.1.0
ASKDATA_DEBUG_MODE=false
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=200
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=pagila
# Read-only demo user created by scripts/create_app_role.sql; postgres is only for loading data.
POSTGRES_USER=askdata_reader
POSTGRES_PASSWORD=postgres
# Alternative to the POSTGRES_* lines: DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_URL=
# false for a hosted demo: refuses runtime database connections and hides "Connect PostgreSQL".
ASKDATA_ALLOW_CUSTOM_DB=true
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
OPENAI_API_KEY=
OPENAI_SQL_MODEL=gpt-6.1-sol
OPENAI_SUMMARY_MODEL=gpt-6-luna
# reasoning.effort per role (none, low, medium, ...); empty = model default (gpt-6.1-sol: low and up)
OPENAI_SQL_REASONING_EFFORT=low
OPENAI_SUMMARY_REASONING_EFFORT=none
